<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  
  # Rule 1: If the requested file or directory exists, serve it directly
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  
  # Rule 2: If it doesn't exist, route everything to index.html (for React Router)
  RewriteRule ^ index.html [QSA,L]
</IfModule>
